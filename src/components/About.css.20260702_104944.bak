.about-section {
  position: relative;
}

/* ========================
   MAIN GRID
======================== */
.about-content {
  display: grid;
  grid-template-columns: 420px 1fr;
  gap: 5rem;
  align-items: start;
  margin-bottom: 5rem;
}

/* ========================
   LEFT: TRANSPARENT PROFILE PHOTO
======================== */
.about-photo-wrapper {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
}

.about-img-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 320px;
  height: 320px;
  background: radial-gradient(circle, rgba(0, 240, 255, 0.25) 0%, rgba(157, 0, 255, 0.25) 50%, transparent 70%);
  border-radius: 50%;
  filter: blur(50px);
  z-index: -1;
  pointer-events: none;
}

.about-avatar-container {
  width: 100%;
  max-width: 320px;
  border-radius: 24px;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
  border: 1px solid var(--border-color);
  backdrop-filter: blur(8px);
  padding: 1.5rem 1.5rem 0; /* padding at bottom is 0 so the photo sits flat */
  overflow: hidden;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  position: relative;
}

.about-avatar-container::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 60%, rgba(6, 6, 20, 0.8));
  pointer-events: none;
  z-index: 1;
}

.about-avatar-img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  transition: transform 0.5s ease, filter 0.5s ease;
  filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.6));
}

.about-avatar-container:hover .about-avatar-img {
  transform: scale(1.04) translateY(-4px);
  filter: drop-shadow(0 15px 25px rgba(157, 0, 255, 0.5));
}

/* Badge on top of photo */
.about-badge {
  position: absolute;
  bottom: -15px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 0.8rem;
  padding: 0.8rem 1.2rem;
  z-index: 10;
  white-space: nowrap;
}

.badge-icon { font-size: 1.3rem; }

.about-badge .badge-num {
  display: block;
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 800;
  background: linear-gradient(135deg, var(--accent-color), var(--accent-purple));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1;
}

.about-badge .badge-text {
  display: block;
  font-size: 0.7rem;
  color: var(--text-secondary);
  font-weight: 500;
}

/* ========================
   RIGHT: TEXT
======================== */
.about-lead {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 1.5rem;
  line-height: 1.6;
}

.about-body {
  color: var(--text-secondary);
  font-size: 1.05rem;
  line-height: 1.9;
  margin-bottom: 2rem;
}

.personal-info {
  padding: 1.8rem;
  margin-bottom: 2rem;
}

.info-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  padding: 0.8rem 0;
  border-bottom: 1px solid var(--border-color);
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  display: block;
  font-size: 0.75rem;
  color: var(--text-secondary);
  margin-bottom: 0.2rem;
  font-weight: 500;
}

.info-value {
  display: block;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-color);
}

.about-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.about-tag {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  font-size: 0.8rem;
  font-weight: 500;
  padding: 0.4rem 1rem;
  border-radius: 30px;
  transition: all 0.3s ease;
}

.about-tag:hover {
  border-color: var(--accent-color);
  color: var(--accent-color);
  background: rgba(0, 240, 255, 0.08);
/* ========================
   RESPONSIVE
======================== */
@media (max-width: 1100px) {
  .about-content {
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  .about-photo-wrapper {
    max-width: 320px;
    margin: 0 auto;
  }

  .about-badge {
    bottom: -20px;
  }
}

@media (max-width: 576px) {
  .info-row {
    grid-template-columns: 1fr;
  }
}
